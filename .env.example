# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA versione o arquivo .env (ele está no .gitignore).
# Em Lovable Cloud, estas variáveis são geradas automaticamente.

# Cliente (expostas ao browser — apenas chaves publishable)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Servidor (NUNCA expor ao cliente)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
